<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\PowerPete.Analyzer.Domain\PowerPete.Analyzer.Domain.csproj" />
    <ProjectReference Include="..\PowerPete.Analyzer.Data\PowerPete.Analyzer.Data.csproj" />
    <ProjectReference Include="..\PowerPete.Analyzer.Dataverse\PowerPete.Analyzer.Dataverse.csproj" />
    <ProjectReference Include="..\PowerPete.Analyzer.Export\PowerPete.Analyzer.Export.csproj" />
    <ProjectReference Include="..\PowerPete.Analyzer.DevOps\PowerPete.Analyzer.DevOps.csproj" />
    <!-- For the demonstration engagement, whose numbers are produced by the real
         assessor rather than written out, so the demo cannot disagree with the product. -->
    <ProjectReference Include="..\PowerPete.Analyzer.Pipeline\PowerPete.Analyzer.Pipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" />

    <!--
      The keys that sign an interactive sign-in's state, kept in blob storage and wrapped
      with a vault key rather than written inside the container. Blobs was already pinned in
      Directory.Packages.props and referenced by nothing, which is how long the intent had
      been sitting there.
    -->
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
    <PackageReference Include="Microsoft.Identity.Web" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
