<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PowerPete.Analyzer.Domain\PowerPete.Analyzer.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The schema travels with the assembly. A container that carries its own migrations
      cannot be deployed against a database it does not know how to build, and a migration
      read from disk is one that can go missing between the build and the deployment.
    -->
    <EmbeddedResource Include="..\..\db\migrations\*.sql"
                      LogicalName="PowerPete.Analyzer.Data.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
