<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Test names are sentences. A failing test report is where a name is read most. -->
    <NoWarn>$(NoWarn);CA1707;CA1034;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referencing a web project brings its framework with it. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <!-- The API, so the sign-in logic can be tested at all. It decides whether to believe
         a callback, and nothing outside the web project could reach it. -->
    <ProjectReference Include="..\..\src\PowerPete.Analyzer.Api\PowerPete.Analyzer.Api.csproj" />
    <ProjectReference Include="..\..\src\PowerPete.Analyzer.Analysis\PowerPete.Analyzer.Analysis.csproj" />
    <ProjectReference Include="..\..\src\PowerPete.Analyzer.Data\PowerPete.Analyzer.Data.csproj" />
    <ProjectReference Include="..\..\src\PowerPete.Analyzer.Dataverse\PowerPete.Analyzer.Dataverse.csproj" />
    <ProjectReference Include="..\..\src\PowerPete.Analyzer.DevOps\PowerPete.Analyzer.DevOps.csproj" />
    <ProjectReference Include="..\..\src\PowerPete.Analyzer.Estimation\PowerPete.Analyzer.Estimation.csproj" />
    <ProjectReference Include="..\..\src\PowerPete.Analyzer.Export\PowerPete.Analyzer.Export.csproj" />
    <ProjectReference Include="..\..\src\PowerPete.Analyzer.Extraction\PowerPete.Analyzer.Extraction.csproj" />
    <ProjectReference Include="..\..\src\PowerPete.Analyzer.Pipeline\PowerPete.Analyzer.Pipeline.csproj" />
  </ItemGroup>

</Project>
