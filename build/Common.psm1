<#
.SYNOPSIS
    Shared helpers for every script in build/.

.DESCRIPTION
    Import this rather than copying helpers between scripts. Two scripts that each
    carry their own copy of a path resolver are two scripts that will eventually
    disagree about where the repository root is.
#>

Set-StrictMode -Version Latest

function Get-RepositoryRoot
{
    <#
    .SYNOPSIS
        The absolute path to the repository root.

    .DESCRIPTION
        Derived from this module's own location rather than from the current directory,
        so a script works the same whether it was started from the root, from build/,
        or by a container build step that has no working directory worth the name.

    .EXAMPLE
        $root = Get-RepositoryRoot
    #>
    [CmdletBinding()]
    [OutputType([string])]
    param()

    return (Resolve-Path (Join-Path $PSScriptRoot '..')).Path
}

function Get-Contract
{
    <#
    .SYNOPSIS
        Reads one contract from build/contracts and returns it as an object.

    .DESCRIPTION
        Contracts are the source of truth for the model, the connectors, the target
        mapping, the pipeline and the estimator. Everything generated is generated from
        one of these. Reading them through this function means a missing or malformed
        contract fails once, here, with the file named, rather than failing later as a
        null reference in a generator.

    .PARAMETER Name
        The contract file name without its extension, for example 'canonical-config-model'.

    .EXAMPLE
        $model = Get-Contract -Name canonical-config-model
        $model.entities.Count
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Name
    )

    $path = Join-Path (Get-RepositoryRoot) "build/contracts/$Name.json"
    if (-not (Test-Path $path))
    {
        throw "Contract '$Name' not found at $path. Contracts live in build/contracts and are the source of truth; a generator cannot invent one."
    }

    try
    {
        return Get-Content -Path $path -Raw -Encoding utf8 | ConvertFrom-Json
    }
    catch
    {
        throw "Contract '$Name' at $path is not valid JSON: $($_.Exception.Message)"
    }
}

function Write-GeneratedFile
{
    <#
    .SYNOPSIS
        Writes a generated file, creating its directory when absent.

    .DESCRIPTION
        Every file written through this carries a header saying which contract produced
        it and that hand edits are pointless because the next build overwrites them.
        The header is not decoration. Somebody will open one of these files, change it,
        and lose an afternoon before noticing, unless the first line stops them.

    .PARAMETER Path
        Absolute path to write to.

    .PARAMETER Content
        The file body, without the header.

    .PARAMETER Contract
        The contract file that produced this output, for the header.

    .PARAMETER CommentPrefix
        Line comment marker for the target language. Defaults to '//'.

    .EXAMPLE
        Write-GeneratedFile -Path $out -Content $code -Contract 'canonical-config-model.json'
    #>
    [CmdletBinding(SupportsShouldProcess)]
    param(
        [Parameter(Mandatory)] [string] $Path,
        [Parameter(Mandatory)] [string] $Content,
        [Parameter(Mandatory)] [string] $Contract,
        [string] $CommentPrefix = '//'
    )

    $header = @(
        "$CommentPrefix <auto-generated>"
        "$CommentPrefix Generated from build/contracts/$Contract by build/Invoke-CodeGen.ps1."
        "$CommentPrefix Do not edit. This file is recreated on every build and is not committed."
        "$CommentPrefix To change what is here, change the contract and run the generator."
        "$CommentPrefix </auto-generated>"
        ''
    ) -join "`n"

    # The auto-generated header above makes the C# compiler treat the file as generated,
    # and generated files are outside the nullable context the project sets. Without this
    # directive every nullable annotation in the output is an error, which is a confusing
    # way to find out that the header is doing its job.
    if ([System.IO.Path]::GetExtension($Path) -eq '.cs')
    {
        $header += "#nullable enable`n`n"
    }

    $directory = Split-Path -Parent $Path
    if (-not (Test-Path $directory))
    {
        $null = New-Item -ItemType Directory -Path $directory -Force
    }

    if ($PSCmdlet.ShouldProcess($Path, 'Write generated file'))
    {
        # UTF-8 without a byte order mark. A BOM in a .cs file is harmless and a BOM in
        # a .sql file run through some tooling is not, so both are written the same way.
        $encoding = New-Object System.Text.UTF8Encoding($false)
        [System.IO.File]::WriteAllText($Path, $header + $Content, $encoding)
    }
}

function ConvertTo-PascalCase
{
    <#
    .SYNOPSIS
        Upper cases the first letter of a contract identifier, so it can be a C# member name.

    .DESCRIPTION
        Contract identifiers are lowerCamelCase: lowCode, proCode, solutionZip. The C# that
        reads them expects LowCode, ProCode, SolutionZip, so the only transformation needed
        is the first letter. The rest of the string is left exactly as it is, because the
        casing after the first character is already what the generated enum member should be.

        It does not split on separators. A contract id containing a hyphen, a space or a dot
        produces an invalid C# identifier and fails the build, which is the intended outcome:
        the fix belongs in the contract, not in a silent normalisation here.

    .PARAMETER Value
        The identifier to convert, for example lowCode.

    .EXAMPLE
        ConvertTo-PascalCase 'solutionZip'

        Returns SolutionZip.
    #>
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory, Position = 0)]
        [string] $Value
    )

    if ([string]::IsNullOrWhiteSpace($Value))
    {
        throw 'ConvertTo-PascalCase was given an empty identifier. A contract entry is missing a name.'
    }

    return $Value.Substring(0, 1).ToUpperInvariant() + $Value.Substring(1)
}

<#
.SYNOPSIS
    Checks a command line tool is installed, and says where to get it if not.

.DESCRIPTION
    Written for someone who has never used Azure. "az: command not found" is a message that
    sends a consultant to a search engine; this one sends them to the installer.

.PARAMETER Name
    The command, for example az or sqlcmd.

.PARAMETER InstallHint
    Where to get it.

.EXAMPLE
    Assert-Command -Name az -InstallHint 'Install from https://aka.ms/installazurecli'

    Returns the command, or throws with the hint.
#>
function Assert-Command
{
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string] $Name,
        [string] $InstallHint = ''
    )

    $command = Get-Command -Name $Name -ErrorAction SilentlyContinue

    if (-not $command)
    {
        $message = "'$Name' is not installed, or is not on PATH."
        if ($InstallHint) { $message += " $InstallHint" }
        throw $message
    }

    return $command
}

<#
.SYNOPSIS
    Reads the version from the VERSION file at the repository root.

.DESCRIPTION
    The one place a version is written. It is what the assemblies report and what the
    container image is tagged with, so two deployments can be told apart.

.EXAMPLE
    Get-RepositoryVersion

    Returns something like 0.11.0.
#>
function Get-RepositoryVersion
{
    [CmdletBinding()]
    param()

    $path = Join-Path (Get-RepositoryRoot) 'VERSION'

    if (-not (Test-Path $path))
    {
        throw "No VERSION file at $path. It is the one place the version is written."
    }

    return (Get-Content $path -Raw).Trim()
}

Export-ModuleMember -Function Get-RepositoryRoot, Get-Contract, Write-GeneratedFile, ConvertTo-PascalCase, Assert-Command, Get-RepositoryVersion
